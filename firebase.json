{
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "redirects": [
      {
        "//": "El programa de Super-Anfitriones se descontinuo (2026-09-07). La pagina sale de circulacion con un 301 a la home, que es lo que preserva el SEO. El archivo public/anfitriones.html se conserva por si hay que restituirla.",
        "source": "/anfitriones",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/anfitriones.html",
        "destination": "/",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "/.well-known/apple-app-site-association",
        "headers": [
          { "key": "Content-Type", "value": "application/json" }
        ]
      },
      {
        "source": "/.well-known/assetlinks.json",
        "headers": [
          { "key": "Content-Type", "value": "application/json" }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/api/recent-activities",
        "function": "recentActivities",
        "region": "southamerica-west1"
      },
      {
        "source": "/api/host-application",
        "function": "submitHostApplication",
        "region": "southamerica-west1"
      },
      {
        "source": "/activity/**",
        "function": "activitySSR",
        "region": "southamerica-west1"
      },
      {
        "source": "/invite/**",
        "function": "activitySSR",
        "region": "southamerica-west1"
      }
    ]
  }
}